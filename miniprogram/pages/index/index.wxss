.page {
  padding: 24rpx;
  background: #f6f8fb;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.06);
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  margin-bottom: 12rpx;
}

.tip {
  font-size: 24rpx;
  color: #64748b;
}

.row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.label {
  width: 96rpx;
  font-size: 26rpx;
  color: #334155;
}

.input {
  flex: 1;
  background: #f1f5f9;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
  font-size: 26rpx;
}

.btn {
  margin-top: 8rpx;
  font-size: 28rpx;
}

.item {
  border-top: 1rpx solid #e2e8f0;
  padding-top: 16rpx;
  margin-top: 16rpx;
}

.item-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.nick {
  font-size: 26rpx;
  color: #1e6cf0;
  font-weight: 600;
}

.time {
  font-size: 22rpx;
  color: #94a3b8;
}

.content {
  font-size: 26rpx;
  color: #334155;
  line-height: 1.6;
}

.log {
  font-family: Menlo, Consolas, monospace;
  font-size: 20rpx;
  color: #475569;
  word-break: break-all;
  margin-bottom: 6rpx;
}
